{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "A comprehensive Playwright testing framework with web and API capabilities.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:api": "playwright test tests/api",
    "cucumber": "cucumber-js --require-module ts-node/register --require tests/steps/**/*.ts tests/features/**/*.feature --format progress --format json:${REPORTS_DIR:-artifacts}/cucumber.json",
    "lint": "eslint . --ext .ts,.js",
    "test:json": "playwright test --reporter=json:artifacts/playwright-report.json",
    "triage": "ts-node scripts/triage.ts artifacts/playwright-report.json",
    "test:playwright:json": "npx playwright test --reporter=json:artifacts/playwright-report.json --reporter=html:artifacts/playwright-html-report",
    "test:playwright:ci": "npm run test:playwright:json && npm run report:generate",
    "test:cucumber:json": "npx cucumber-js --require-module ts-node/register --format json:artifacts/cucumber.json \"tests/features\"",
    "report:generate": "ts-node src/tools/generate-report.ts",
    "report:open": "npx playwright show-report artifacts/playwright-html-report || open artifacts/summary-report.html",
    "ci:run-and-report": "npx playwright test --reporter=json:artifacts/playwright-report.json --reporter=html:artifacts/playwright-html-report && ts-node src/report-tool/richer-report.ts"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "dotenv": "^10.0.0",
    "fs-extra": "^11.1.1",
    "mysql2": "^3.2.0",
    "resemblejs": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^8.0.0",
    "@playwright/test": "^1.40.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^18.0.0",
    "@types/xlsx": "^0.0.34",
    "allure-commandline": "^2.13.0",
    "dayjs": "^1.11.9",
    "eslint": "^7.0.0",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "prettier": "^2.0.0",
    "sanitize-filename": "^1.6.3",
    "ts-node": "^10.0.0",
    "typescript": "^4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/playwright-e2e-framework.git"
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "api",
    "cucumber",
    "testng"
  ],
  "author": "Your Name",
  "license": "MIT",
  "default": {
    "requireModule": [
      "ts-node/register"
    ],
    "require": [
      "tests/steps/**/*.ts"
    ],
    "publish": false,
    "format": [
      "progress"
    ]
  },
  "overrides": {
    "minimatch": "^5.1.3",
    "tar": "^6.1.11"
  }
}
